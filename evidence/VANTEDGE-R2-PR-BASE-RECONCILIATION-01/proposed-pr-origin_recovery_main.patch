+++ b/app/src/main/java/com/vantedge/app/data/domain/CompatibilityRecordMapper.kt
@@ -0,0 +1,510 @@
+package com.vantedge.app.data.domain
+
+import com.vantedge.app.data.model.*
+import com.vantedge.app.domain.PipelineTrace
+import com.vantedge.app.narrative.W5Evidence
+import com.vantedge.app.w5.scoring.*
+
+data class CompatibilityEvidenceReport(
+    val diagnostics: List<RequirementDiagnostic>,
+    val summary: DiagnosticsSummary
+)
+
+data class CompatibilityMappingResult(
+    val record: CompatibilityRecord,
+    val evidenceReport: CompatibilityEvidenceReport,
+    val w5Evidence: W5Evidence
+)
+
+class CompatibilityRecordMapper {
+
+    fun map(
+        scoreResult: ScoreResult,
+        profile: UserProfile,
+        normalizedProfile: NormalizedProfile,
+        validatedProfile: ValidatedProfile,
+        jobTitle: String,
+        company: String,
+        jobDescription: String,
+        roleSummary: String,
+        eligibilitySummary: String,
+        currentYear: Int,
+        validatedJob: ValidatedJob,
+        diagnostics: RequirementDiagnostics
+    ): CompatibilityMappingResult {
+        val correlationId = scoreResult.correlationId
+        val startMs = System.currentTimeMillis()
+        PipelineTrace.entry("CompatibilityRecordMapper", mapOf(
+            "correlationId" to correlationId,
+            "totalScore" to scoreResult.totalScore,
+            "confidence" to scoreResult.confidence
+        ))
+
+        val evidenceReport = CompatibilityEvidenceReport(
+            diagnostics = diagnostics.diagnostics,
+            summary = diagnostics.summary
+        )
+
+        val gapAnalysis = scoreResult.gapAnalysis
+
+        val score = (scoreResult.totalScore.coerceIn(0.0, 1.0) * 100).toInt()
+
+        val skillMatchAxis = scoreResult.axisScores.first { it.axisName == "SkillMatch" }
+        val skillMatch = skillMatchAxis.score
+        val experienceAlignmentAxis = scoreResult.axisScores.first { it.axisName == "ExperienceAlignment" }
+        val experienceAlignment = experienceAlignmentAxis.score
+        val constraintAxis = scoreResult.axisScores.first { it.axisName == "ConstraintCompliance" }
+        val constraintCompliance = constraintAxis.score
+        val vacancyScore = (
+            (skillMatch * 0.5) + (experienceAlignment * 0.3) + (constraintCompliance * 0.2)
+        ).coerceIn(0.0, 1.0).times(100).toInt()
+
+        val provisionalScore = scoreResult.provisionalTotalScore
+            ?.coerceIn(0.0, 1.0)
+            ?.let { (it * 100).toInt() }
+
+        val vacancyComponents = listOf(
+            Triple("SkillMatch", 0.5, skillMatchAxis),
+            Triple("ExperienceAlignment", 0.3, experienceAlignmentAxis),
+            Triple("ConstraintCompliance", 0.2, constraintAxis)
+        )
+        val measuredVacancyComponents = vacancyComponents.filter { it.third.isMeasured }
+        val measuredVacancyWeight = measuredVacancyComponents.sumOf { it.second }
+        val hasVacancyEvidence = measuredVacancyComponents.any {
+            it.first == "SkillMatch" || it.first == "ExperienceAlignment"
+        }
+        val provisionalVacancyScore = if (!hasVacancyEvidence || measuredVacancyWeight <= 1e-9) {
+            null
+        } else {
+            (measuredVacancyComponents.sumOf { it.third.score * it.second } / measuredVacancyWeight)
+                .coerceIn(0.0, 1.0)
+                .times(100)
+                .toInt()
+        }
+
+        val w5Evidence = W5Evidence(
+            skillMatch = skillMatch,
+            experienceAlignment = experienceAlignmentAxis.takeIf { it.isMeasured }?.score,
+            constraintCompliance = constraintCompliance,
+            confidence = scoreResult.confidence
+        )
+
+        val relevancyItems = gapAnalysis.matched.map {
+            RelevancyItem(
+                name = it.name,
+                type = "skill",
+                matchPercent = (it.similarity * 100).toInt(),
+                aiDescription = "",
+                relevancyGroup = when {
+                    it.similarity >= 0.75 -> "HIGH"
+                    it.similarity >= 0.50 -> "MEDIUM"
+                    it.similarity >= 0.30 -> "LOW"
+                    else -> "PROFESSIONAL_MISMATCH"
+                }
+            )
+        }
+
+        val qualificationRatio = QualificationRatio(
+            matched = gapAnalysis.matched.size,
+            total = gapAnalysis.matched.size + gapAnalysis.weak.size + gapAnalysis.missing.size,
+            gaps = gapAnalysis.weak.size + gapAnalysis.missing.size
+        )
+
+        val isDegraded = validatedJob.isDegraded
+
+        val baseDataIntegrityNote = if (evidenceReport.summary.totalUnmapped > 0) {
+            val categoryBreakdown = evidenceReport.diagnostics
+                .groupBy { it.category }
+                .mapValues { it.value.size }
+                .entries
+                .joinToString(", ") { "${it.value} ${it.key}" }
+            "${evidenceReport.summary.totalUnmapped} unmapped requirement(s) ($categoryBreakdown)"
+        } else if (isDegraded) {
+            "Degraded job data — extraction confidence low"
+        } else {
+            "Derived from deterministic profile evidence"
+        }
+
+        val qualificationRequirementsPresent = validatedJob.requiredQualifications.isNotEmpty()
+        val profileQualificationsAssessed = validatedProfile.qualifications.isNotEmpty()
+        val qualificationsAssessed = !qualificationRequirementsPresent || profileQualificationsAssessed
+
+        val matchedQualifications = if (qualificationsAssessed) {
+            validatedJob.requiredQualifications.filter { jobReq ->
+                validatedProfile.qualifications.any { profileQual ->
+                    profileQual.category == jobReq.category &&
+                    jaccard(
+                        tokenize(profileQual.originalText, emptySet()).toSet(),
+                        tokenize(jobReq.originalText, emptySet()).toSet()
+                    ) > 0.3
+                }
+            }
+        } else {
+            emptyList()
+        }
+
+        val missingQualifications = if (qualificationsAssessed) {
+            validatedJob.requiredQualifications.filterNot { jobReq ->
+                validatedProfile.qualifications.any { profileQual ->
+                    profileQual.category == jobReq.category &&
+                    jaccard(
+                        tokenize(profileQual.originalText, emptySet()).toSet(),
+                        tokenize(jobReq.originalText, emptySet()).toSet()
+                    ) > 0.3
+                }
+            }
+        } else {
+            emptyList()
+        }
+
+        val gaps = gapAnalysis.missing.map {
+            GapItem(skill = it, importance = "MANDATORY", description = "", experienceGap = false, platformGap = false, courses = emptyList())
+        } + gapAnalysis.weak.map {
+            GapItem(skill = it, importance = "IMPORTANT", description = "", experienceGap = false, platformGap = false, courses = emptyList())
+        } + missingQualifications.map {
+            GapItem(skill = "${it.category}: ${it.originalText}", importance = "MANDATORY", description = "", experienceGap = false, platformGap = false, courses = emptyList())
+        }
+
+        val criticalGapCount = gaps.count { it.importance == "MANDATORY" }
+
+        val qualificationNote = when {
+            missingQualifications.isNotEmpty() && matchedQualifications.isNotEmpty() -> {
+                " Matched: ${matchedQualifications.joinToString(", ") { "${it.category}: ${it.originalText}" }}. Missing: ${missingQualifications.joinToString(", ") { "${it.category}: ${it.originalText}" }}"
+            }
+            missingQualifications.isNotEmpty() -> {
+                " Missing qualifications: ${missingQualifications.joinToString(", ") { "${it.category}: ${it.originalText}" }}"
+            }
+            matchedQualifications.isNotEmpty() -> {
+                " All required qualifications matched: ${matchedQualifications.joinToString(", ") { "${it.category}: ${it.originalText}" }}"
+            }
+            else -> ""
+        }
+
+        val dataIntegrityNote = baseDataIntegrityNote + qualificationNote
+
+        val profileStats = ProfileStats(
+            yearsExperience = computeYearsExperience(profile.workHistory, currentYear),
+            certificationCount = normalizedProfile.certifications.size,
+            skillCount = validatedProfile.skills.size,
+            matchedCount = gapAnalysis.matched.size,
+            gapCount = gapAnalysis.missing.size + gapAnalysis.weak.size,
+            dataIntegrityNote = dataIntegrityNote
+        )
+
+        val requirementAssessments = buildRequirementAssessments(
+            validatedJob = validatedJob,
+            inventory = diagnostics.inventory,
+            gapAnalysis = gapAnalysis,
+            matchedQualifications = matchedQualifications,
+            missingQualifications = missingQualifications,
+            qualificationsAssessed = qualificationsAssessed,
+            profileSkills = validatedProfile.skills
+        )
+        val blockingUnassessed = requirementAssessments.any {
+            it.state == RequirementAssessmentState.UNASSESSED && it.importance != "PREFERRED"
+        }
+
+        val record = CompatibilityRecord(
+            jobTitle = jobTitle,
+            company = company,
+            jobDescription = jobDescription,
+            score = score,
+            vacancyScore = vacancyScore,
+            roleSummary = roleSummary,
+            eligibilitySummary = eligibilitySummary,
+            dataIntegrityNote = dataIntegrityNote,
+            profileStats = profileStats,
+            qualificationRatio = qualificationRatio,
+            relevancyItems = relevancyItems,
+            gaps = gaps,
+            criticalGapCount = criticalGapCount,
+            analysisSource = CompatibilityAnalysisSource.DETERMINISTIC_W5,
+            // preferredReconstructable is informational: false means preferred requirements could not be
+            // reconstructed from the fallback source, not that the full inventory was reconstructed.
+            // Preferred requirements are non-blocking; required unassessed/unreconciled items still block this gate.
+            evaluationComplete = scoreResult.isComplete && qualificationsAssessed && !blockingUnassessed,
+            provisionalScore = provisionalScore,
+            provisionalVacancyScore = provisionalVacancyScore,
+            requirementAssessments = requirementAssessments
+        )
+
+        val durationMs = System.currentTimeMillis() - startMs
+        PipelineTrace.dataQuality(
+            stage = "CompatibilityRecordMapper",
+            issue = "RECORD_MAPPED",
+            details = mapOf(
+                "correlationId" to correlationId,
+                "score" to record.score,
+                "vacancyScore" to record.vacancyScore,
+                "criticalGapCount" to record.criticalGapCount,
+                "gapCount" to record.gaps.size,
+                "matchedCount" to record.relevancyItems.size,
+                "dataIntegrityNote" to record.dataIntegrityNote,
+                "unmappedRequirementCount" to evidenceReport.summary.totalUnmapped,
+                "classificationWarningCount" to evidenceReport.diagnostics.size,
+                "inventorySource" to if (diagnostics.inventory.isNotEmpty()) "DIAGNOSTICS" else "SYNTHESIZED",
+                "preferredReconstructable" to diagnostics.inventory.isNotEmpty().toString(),
+                "provisionalScore" to (record.provisionalScore ?: "unknown"),
+                "provisionalVacancyScore" to (record.provisionalVacancyScore ?: "unknown"),
+                "unassessedRequirementCount" to requirementAssessments.count {
+                    it.state == RequirementAssessmentState.UNASSESSED
+                }
+            ),
+            correlationId = correlationId
+        )
+        PipelineTrace.exit("CompatibilityRecordMapper", durationMs, mapOf(
+            "correlationId" to correlationId,
+            "score" to record.score,
+            "gapCount" to record.gaps.size,
+            "dataIntegrityNote" to record.dataIntegrityNote
+        ))
+
+        return CompatibilityMappingResult(
+            record = record,
+            evidenceReport = evidenceReport,
+            w5Evidence = w5Evidence
+        )
+    }
+
+    private val qualificationCategories = setOf(
+        RequirementCategory.DEGREE,
+        RequirementCategory.CERTIFICATION,
+        RequirementCategory.LICENCE,
+        RequirementCategory.SECURITY_CLEARANCE
+    )
+
+    private fun buildRequirementAssessments(
+        validatedJob: ValidatedJob,
+        inventory: List<RequirementEvidence>,
+        gapAnalysis: GapAnalysis,
+        matchedQualifications: List<RequirementEvidence>,
+        missingQualifications: List<RequirementEvidence>,
+        qualificationsAssessed: Boolean,
+        profileSkills: List<String>
+    ): List<RequirementAssessment> {
+        val source = if (inventory.isNotEmpty()) {
+            inventory
+        } else {
+            synthesizeRequirementInventory(validatedJob)
+        }
+        val distinctSource = source.distinctBy {
+            listOf(
+                it.originalText,
+                it.category.name,
+                it.matchedTaxonomySkill,
+                it.importance,
+                it.classificationStatus.name
+            )
+        }
+        val requiredQualificationKeys = validatedJob.requiredQualifications
+            .map { it.category to it.originalText }
+            .toSet()
+        val assessmentSource = distinctSource.filter { evidence ->
+            evidence.category !in qualificationCategories ||
+                (evidence.category to evidence.originalText) in requiredQualificationKeys
+        }
+        val matchedSkills = gapAnalysis.matched.map { it.name }.toSet()
+        val weakSkills = gapAnalysis.weak.toSet()
+        val missingSkills = gapAnalysis.missing.toSet()
+
+        val assessments = assessmentSource.map { evidence ->
+            when {
+                evidence.category == RequirementCategory.SKILL ->
+                    assessSkill(
+                        evidence,
+                        matchedSkills,
+                        weakSkills,
+                        missingSkills,
+                        profileSkills
+                    )
+                evidence.category in qualificationCategories ->
+                    assessQualification(
+                        evidence,
+                        matchedQualifications,
+                        missingQualifications,
+                        qualificationsAssessed
+                    )
+                evidence.classificationStatus == ClassificationStatus.UNMAPPED ->
+                    unassessed(evidence, UnassessedReason.TAXONOMY_MISS)
+                else ->
+                    unassessed(evidence, UnassessedReason.UNSUPPORTED_CATEGORY)
+            }
+        }
+        val qualificationCategoryNames = qualificationCategories.map { it.name }.toSet()
+        val assessedQualificationKeys = assessments
+            .filter { it.category in qualificationCategoryNames }
+            .map { it.category to it.text }
+            .toSet()
+        val reconciledQualifications = validatedJob.requiredQualifications
+            .filter { (it.category.name to it.originalText) !in assessedQualificationKeys }
+            .map { qualification ->
+                assessQualification(
+                    qualification,
+                    matchedQualifications,
+                    missingQualifications,
+                    qualificationsAssessed
+                )
+            }
+        return assessments + reconciledQualifications
+    }
+
+    private fun hasProfileEvidence(
+        evidence: RequirementEvidence,
+        profileSkills: List<String>
+    ): Boolean = profileSkills.any { skill ->
+        skill.equals(evidence.matchedTaxonomySkill, ignoreCase = true) ||
+            skill.equals(evidence.originalText, ignoreCase = true)
+    }
+
+    private fun assessSkill(
+        evidence: RequirementEvidence,
+        matchedSkills: Set<String>,
+        weakSkills: Set<String>,
+        missingSkills: Set<String>,
+        profileSkills: List<String>
+    ): RequirementAssessment {
+        val canonical = evidence.matchedTaxonomySkill
+        val matchedByGap = canonical?.let { it in matchedSkills } == true ||
+            evidence.originalText in matchedSkills
+        val matchedByProfile = evidence.importance == "PREFERRED" &&
+            hasProfileEvidence(evidence, profileSkills)
+
+        if (matchedByGap || matchedByProfile) {
+            return RequirementAssessment(
+                text = evidence.originalText,
+                state = RequirementAssessmentState.MATCHED,
+                canonical = canonical,
+                category = evidence.category.name,
+                importance = evidence.importance ?: "MANDATORY"
+            )
+        }
+
+        if (evidence.importance == "PREFERRED") {
+            return unassessed(evidence, UnassessedReason.PREFERENCE_NOT_ASSESSED)
+        }
+
+        if (canonical == null) {
+            return unassessed(
+                evidence,
+                if (evidence.classificationStatus == ClassificationStatus.UNSUPPORTED) {
+                    UnassessedReason.UNSUPPORTED_CATEGORY
+                } else {
+                    UnassessedReason.TAXONOMY_MISS
+                }
+            )
+        }
+
+        val weak = canonical in weakSkills || evidence.originalText in weakSkills
+        val missing = canonical in missingSkills || evidence.originalText in missingSkills
+
+        return when {
+            weak -> RequirementAssessment(
+                text = evidence.originalText,
+                state = RequirementAssessmentState.CONFIRMED_GAP,
+                canonical = canonical,
+                category = evidence.category.name,
+                importance = "IMPORTANT"
+            )
+            missing -> RequirementAssessment(
+                text = evidence.originalText,
+                state = RequirementAssessmentState.CONFIRMED_GAP,
+                canonical = canonical,
+                category = evidence.category.name,
+                importance = "MANDATORY"
+            )
+            else -> unassessed(
+                evidence,
+                if (profileSkills.isNotEmpty()) {
+                    UnassessedReason.UNRECONCILED
+                } else {
+                    UnassessedReason.PROFILE_SKILL_EVIDENCE_ABSENT
+                }
+            )
+        }
+    }
+
+    private fun assessQualification(
+        evidence: RequirementEvidence,
+        matchedQualifications: List<RequirementEvidence>,
+        missingQualifications: List<RequirementEvidence>,
+        qualificationsAssessed: Boolean
+    ): RequirementAssessment {
+        val canonical = "${evidence.category}: ${evidence.originalText}"
+        val importance = evidence.importance ?: "MANDATORY"
+
+        if (!qualificationsAssessed) {
+            return RequirementAssessment(
+                text = evidence.originalText,
+                state = RequirementAssessmentState.UNASSESSED,
+                canonical = canonical,
+                reason = UnassessedReason.PROFILE_QUALIFICATION_EVIDENCE_ABSENT.name,
+                category = evidence.category.name,
+                importance = importance
+            )
+        }
+
+        val matched = matchedQualifications.any {
+            it.category == evidence.category && it.originalText == evidence.originalText
+        }
+        val missing = missingQualifications.any {
+            it.category == evidence.category && it.originalText == evidence.originalText
+        }
+
+        return when {
+            matched -> RequirementAssessment(
+                text = evidence.originalText,
+                state = RequirementAssessmentState.MATCHED,
+                canonical = canonical,
+                category = evidence.category.name,
+                importance = importance
+            )
+            missing -> RequirementAssessment(
+                text = evidence.originalText,
+                state = RequirementAssessmentState.CONFIRMED_GAP,
+                canonical = canonical,
+                category = evidence.category.name,
+                importance = "MANDATORY"
+            )
+            else -> RequirementAssessment(
+                text = evidence.originalText,
+                state = RequirementAssessmentState.UNASSESSED,
+                canonical = canonical,
+                reason = UnassessedReason.UNRECONCILED.name,
+                category = evidence.category.name,
+                importance = importance
+            )
+        }
+    }
+
+    private fun unassessed(
+        evidence: RequirementEvidence,
+        reason: UnassessedReason
+    ): RequirementAssessment = RequirementAssessment(
+        text = evidence.originalText,
+        state = RequirementAssessmentState.UNASSESSED,
+        canonical = evidence.matchedTaxonomySkill,
+        reason = reason.name,
+        category = evidence.category.name,
+        importance = evidence.importance ?: "MANDATORY"
+    )
+
+    private fun synthesizeRequirementInventory(validatedJob: ValidatedJob): List<RequirementEvidence> =
+        validatedJob.requiredSkills.map {
+            RequirementEvidence(
+                originalText = it,
+                category = RequirementCategory.SKILL,
+                classificationStatus = ClassificationStatus.NORMALIZED,
+                matchedTaxonomySkill = it,
+                importance = "MANDATORY"
+            )
+        } + validatedJob.requiredQualifications.map {
+            RequirementEvidence(
+                originalText = it.originalText,
+                category = it.category,
+                classificationStatus = it.classificationStatus,
+                matchedTaxonomySkill = it.matchedTaxonomySkill,
+                importance = it.importance ?: "MANDATORY"
+            )
+        }
+
+}
diff --git a/app/src/main/java/com/vantedge/app/w5/scoring/W5Types.kt b/app/src/main/java/com/vantedge/app/w5/scoring/W5Types.kt
new file mode 100644
index 0000000..1ac7a4e
--- /dev/null
+++ b/app/src/main/java/com/vantedge/app/w5/scoring/W5Types.kt
@@ -0,0 +1,124 @@
+package com.vantedge.app.w5.scoring
+
+data class W5TraceContext(
+    val correlationId: String,
+    val inputHash: String,
+    val timestamp: Long
+)
+
+data class ValidatedProfile(
+    val correlationId: String,
+    val skills: List<String>,
+    val qualifications: List<RequirementEvidence> = emptyList(),
+    val roles: List<String>,
+    val currentTitle: String?,
+    val experienceYears: Int,
+    val seniorityLevel: String?,
+    val completedFields: Set<String>,
+    val isAccepted: Boolean,
+    val isDegraded: Boolean
+)
+
+data class ValidatedJob(
+    val correlationId: String,
+    val requiredSkills: List<String>,
+    val requiredQualifications: List<RequirementEvidence> = emptyList(),
+    val title: String,
+    val keywords: List<String>,
+    val requiredYears: Int?,
+    val seniorityLevel: String?,
+    val completedFields: Set<String>,
+    val isAccepted: Boolean,
+    val isDegraded: Boolean
+)
+
+data class W5Input(
+    val profile: ValidatedProfile,
+    val job: ValidatedJob,
+    val trace: W5TraceContext
+)
+
+data class ScoreResult(
+    val correlationId: String,
+    val totalScore: Double,
+    val confidence: Double,
+    val axisScores: List<AxisScore>,
+    val breakdown: ScoreBreakdown,
+    val gapAnalysis: GapAnalysis,
+    val hints: RecommendationHints,
+    val trace: W5TraceContext,
+    val unknownAxes: List<String> = emptyList(),
+    val provisionalTotalScore: Double? = null
+) {
+    val isComplete: Boolean get() = unknownAxes.isEmpty()
+}
+
+data class AxisScore(
+    val axisName: String,
+    val score: Double,
+    val isMeasured: Boolean = true
+)
+
+data class ScoreBreakdown(
+    val axisBreakdowns: List<AxisBreakdown>
+)
+
+data class AxisBreakdown(
+    val axisName: String,
+    val score: Double,
+    val weight: Double,
+    val contributingFactors: List<Factor>
+)
+
+data class Factor(
+    val field: String,
+    val value: String,
+    val contribution: Double
+)
+
+data class MatchEvidence(
+    val name: String,
+    val similarity: Double
+)
+
+data class QualificationGap(
+    val required: RequirementEvidence,
+    val isMatched: Boolean,
+    val matchedProfileEvidence: RequirementEvidence?
+)
+
+data class GapAnalysis(
+    val missing: List<String>,
+    val weak: List<String>,
+    val matched: List<MatchEvidence>,
+    val qualificationGaps: List<QualificationGap> = emptyList(),
+    val unassessed: List<UnassessedRequirement> = emptyList()
+)
+
+enum class UnassessedReason {
+    PROFILE_SKILL_EVIDENCE_ABSENT,
+    PROFILE_QUALIFICATION_EVIDENCE_ABSENT,
+    TAXONOMY_MISS,
+    UNSUPPORTED_CATEGORY,
+    PREFERENCE_NOT_ASSESSED,
+    UNRECONCILED
+}
+
+data class UnassessedRequirement(
+    val text: String,
+    val reason: UnassessedReason
+)
+
+data class RecommendationHints(
+    val hints: List<String>
+)
+
+data class ValidationAssets(
+    val stopWords: Set<String>,
+    val keywordDictionary: Map<String, List<String>>
+)
+
+data class AdaptedW5Input(
+    val profile: ValidatedProfile,
+    val job: ValidatedJob
+)
diff --git a/app/src/test/java/com/vantedge/app/data/storage/CompatibilityRecordLegacyJsonTest.kt b/app/src/test/java/com/vantedge/app/data/storage/CompatibilityRecordLegacyJsonTest.kt
new file mode 100644
index 0000000..12bf185
--- /dev/null
+++ b/app/src/test/java/com/vantedge/app/data/storage/CompatibilityRecordLegacyJsonTest.kt
@@ -0,0 +1,198 @@
+package com.vantedge.app.data.storage
+
+import com.google.gson.Gson
+import com.vantedge.app.data.domain.ScoreCompleteness
+import com.vantedge.app.data.model.CompatibilityRecord
+import com.vantedge.app.data.model.RequirementAssessmentState
+import com.vantedge.app.ui.screens.ScorePresentation
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class CompatibilityRecordLegacyJsonTest {
+
+    private val gson = Gson()
+
+    private fun legacyJson(extra: String = "") = """
+        {
+          "id": 1,
+          "jobTitle": "Developer",
+          "company": "Acme",
+          "jobDescription": "Developer",
+          "score": 85,
+          "vacancyScore": 80,
+          "roleSummary": "",
+          "eligibilitySummary": "You meet all requirements.",
+          "dataIntegrityNote": "",
+          "profileStats": {
+            "yearsExperience": 5,
+            "certificationCount": 0,
+            "skillCount": 1,
+            "matchedCount": 1,
+            "gapCount": 0,
+            "dataIntegrityNote": ""
+          },
+          "qualificationRatio": { "matched": 1, "total": 1, "gaps": 0 },
+          "relevancyItems": [],
+          "gaps": [],
+          "criticalGapCount": 0,
+          "analysisSource": "DETERMINISTIC_W5",
+          "createdAt": 123
+          ${if (extra.isBlank()) "" else ", $extra"}
+        }
+    """.trimIndent()
+
+    @Test
+    fun `missing evaluationComplete deserializes to unknown`() {
+        val record = gson.fromJson(legacyJson(), CompatibilityRecord::class.java)
+
+        assertNull(record.evaluationComplete)
+        assertFalse(ScoreCompleteness.isAuthoritative(record))
+        assertFalse(ScorePresentation.eligibilityClaimAllowed(record))
+    }
+
+    @Test
+    fun `explicit null evaluationComplete remains unknown`() {
+        val record = gson.fromJson(
+            legacyJson("\"evaluationComplete\": null"),
+            CompatibilityRecord::class.java
+        )
+
+        assertNull(record.evaluationComplete)
+        assertFalse(ScoreCompleteness.isAuthoritative(record))
+    }
+
+    @Test
+    fun `existing record fields remain preserved`() {
+        val record = gson.fromJson(legacyJson(), CompatibilityRecord::class.java)
+
+        assertEquals("Developer", record.jobTitle)
+        assertEquals("Acme", record.company)
+        assertEquals(85, record.score)
+        assertEquals(5, record.profileStats.yearsExperience)
+    }
+
+    @Test
+    fun `explicit true remains authoritative when the record permits it`() {
+        val record = gson.fromJson(
+            legacyJson("\"evaluationComplete\": true"),
+            CompatibilityRecord::class.java
+        )
+
+        assertEquals(true, record.evaluationComplete)
+        assertTrue(ScoreCompleteness.isAuthoritative(record))
+        assertTrue(ScorePresentation.eligibilityClaimAllowed(record))
+    }
+
+    @Test
+    fun `gaps prevent a positive eligibility claim`() {
+        val record = gson.fromJson(
+            legacyJson(
+                "\"evaluationComplete\": true, \"gaps\": [" +
+                    "{\"skill\": \"Kubernetes\", \"importance\": \"MANDATORY\", \"description\": \"\", \"courses\": []}" +
+                    "]"
+            ),
+            CompatibilityRecord::class.java
+        )
+
+        assertTrue(ScoreCompleteness.isAuthoritative(record))
+        assertFalse(ScorePresentation.eligibilityClaimAllowed(record))
+        assertFalse(ScorePresentation.eligibilityBody(record).contains("You meet all requirements."))
+        assertTrue(ScorePresentation.eligibilityBody(record).contains("Confirmed gaps"))
+    }
+
+    @Test
+    fun `serialization round trip preserves unknown state`() {
+        val record = gson.fromJson(legacyJson(), CompatibilityRecord::class.java)
+        val roundTripped = gson.fromJson(gson.toJson(record), CompatibilityRecord::class.java)
+
+        assertNull(roundTripped.evaluationComplete)
+        assertFalse(ScoreCompleteness.isAuthoritative(roundTripped))
+    }
+    @Test
+    fun `missing coverage fields deserialize to unknown`() {
+        val record = gson.fromJson(legacyJson(), CompatibilityRecord::class.java)
+
+        assertNull(record.requirementAssessments)
+        assertNull(record.provisionalScore)
+        assertNull(record.provisionalVacancyScore)
+    }
+
+    @Test
+    fun `recorded coverage and provisional values round trip`() {
+        val record = gson.fromJson(
+            legacyJson(
+                "\"provisionalScore\": 72, \"provisionalVacancyScore\": 68, " +
+                    "\"requirementAssessments\": [" +
+                    "{\"text\": \"Kotlin\", \"state\": \"MATCHED\", \"canonical\": \"Kotlin\", \"importance\": \"MANDATORY\"}" +
+                    "]"
+            ),
+            CompatibilityRecord::class.java
+        )
+
+        assertNotNull(record.requirementAssessments)
+        assertEquals(1, record.requirementAssessments!!.size)
+        assertEquals(RequirementAssessmentState.MATCHED, record.requirementAssessments!!.first().state)
+        assertEquals(72, record.provisionalScore)
+        assertEquals(68, record.provisionalVacancyScore)
+
+        val roundTripped = gson.fromJson(gson.toJson(record), CompatibilityRecord::class.java)
+        assertNotNull(roundTripped.requirementAssessments)
+        assertEquals(RequirementAssessmentState.MATCHED, roundTripped.requirementAssessments!!.first().state)
+        assertEquals(72, roundTripped.provisionalScore)
+    }
+
+    @Test
+    fun `unassessed reason survives serialization`() {
+        val record = gson.fromJson(
+            legacyJson(
+                "\"requirementAssessments\": [" +
+                    "{\"text\": \"Data Protection\", \"state\": \"UNASSESSED\", \"reason\": \"TAXONOMY_MISS\", \"importance\": \"MANDATORY\"}" +
+                    "]"
+            ),
+            CompatibilityRecord::class.java
+        )
+
+        val roundTripped = gson.fromJson(gson.toJson(record), CompatibilityRecord::class.java)
+        val assessment = roundTripped.requirementAssessments!!.first()
+        assertEquals(RequirementAssessmentState.UNASSESSED, assessment.state)
+        assertEquals("TAXONOMY_MISS", assessment.reason)
+    }
+
+    @Test
+    fun `confirmed gap and preferred assessment round trip`() {
+        val record = gson.fromJson(
+            legacyJson(
+                "\"requirementAssessments\": [" +
+                    "{\"text\": \"Kubernetes\", \"state\": \"CONFIRMED_GAP\", \"canonical\": \"Kubernetes\", \"importance\": \"MANDATORY\"}," +
+                    "{\"text\": \"Docker\", \"state\": \"UNASSESSED\", \"reason\": \"PREFERENCE_NOT_ASSESSED\", \"importance\": \"PREFERRED\"}," +
+                    "{\"text\": \"Legacy Skill\", \"state\": \"UNASSESSED\", \"reason\": \"UNRECONCILED\", \"importance\": \"MANDATORY\"}" +
+                    "]"
+            ),
+            CompatibilityRecord::class.java
+        )
+
+        val roundTripped = gson.fromJson(gson.toJson(record), CompatibilityRecord::class.java)
+        val assessments = roundTripped.requirementAssessments!!
+        assertEquals(3, assessments.size)
+        assertEquals(RequirementAssessmentState.CONFIRMED_GAP, assessments[0].state)
+        assertEquals("PREFERRED", assessments[1].importance)
+        assertEquals("PREFERENCE_NOT_ASSESSED", assessments[1].reason)
+        assertEquals("UNRECONCILED", assessments[2].reason)
+    }
+
+    @Test
+    fun `recorded empty inventory stays distinct from unknown coverage`() {
+        val record = gson.fromJson(
+            legacyJson("\"requirementAssessments\": []"),
+            CompatibilityRecord::class.java
+        )
+
+        assertNotNull(record.requirementAssessments)
+        assertTrue(record.requirementAssessments!!.isEmpty())
+    }
+
+}
diff --git a/app/src/test/java/com/vantedge/app/data/viewmodel/CycleScoreAggregationTest.kt b/app/src/test/java/com/vantedge/app/data/viewmodel/CycleScoreAggregationTest.kt
new file mode 100644
index 0000000..b21a9a0
--- /dev/null
+++ b/app/src/test/java/com/vantedge/app/data/viewmodel/CycleScoreAggregationTest.kt
@@ -0,0 +1,210 @@
+package com.vantedge.app.data.viewmodel
+
+import com.vantedge.app.data.model.CompatibilityRecord
+import com.vantedge.app.data.model.GenerationCycle
+import com.vantedge.app.data.model.ProfileStats
+import com.vantedge.app.data.model.UserProfile
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class CycleScoreAggregationTest {
+
+    private fun record(score: Int, complete: Boolean?, provisional: Int? = null) = CompatibilityRecord(
+        jobTitle = "Developer",
+        company = "Acme",
+        jobDescription = "Developer",
+        score = score,
+        roleSummary = "",
+        eligibilitySummary = "",
+        profileStats = ProfileStats(0, 0, 0, 0, 0, ""),
+        relevancyItems = emptyList(),
+        gaps = emptyList(),
+        criticalGapCount = 0,
+        evaluationComplete = complete,
+        provisionalScore = provisional
+    )
+
+    private fun cycle(
+        id: String,
+        title: String,
+        score: Int,
+        complete: Boolean?,
+        provisional: Int? = null,
+        version: Int? = null,
+        visible: Boolean = true
+    ) = GenerationCycle(
+        id = id,
+        jobTitle = title,
+        company = "Acme",
+        jobDescription = "Developer",
+        profileSnapshot = UserProfile(),
+        version = version,
+        isVisibleInHistory = visible,
+        compatibility = record(score, complete, provisional)
+    )
+
+    @Test
+    fun `average excludes incomplete and legacy records`() {
+        val cycles = listOf(
+            cycle("a", "Engineer A", 80, true),
+            cycle("b", "Engineer B", 40, false),
+            cycle("c", "Engineer C", 100, null),
+            cycle("d", "Engineer D", 60, true)
+        )
+
+        assertEquals(70, CycleScoreAggregation.averageScore(cycles))
+        assertEquals(2, CycleScoreAggregation.incompleteScoreCount(cycles))
+    }
+
+    @Test
+    fun `best role ignores incomplete higher score`() {
+        val cycles = listOf(
+            cycle("a", "Engineer A", 80, true),
+            cycle("b", "Engineer B", 100, false),
+            cycle("c", "Engineer C", 95, null)
+        )
+
+        assertEquals("Engineer A", CycleScoreAggregation.bestScoringRole(cycles))
+    }
+
+    @Test
+    fun `previous score is hidden when either side is incomplete`() {
+        val previousIncomplete = cycle("p", "Engineer", 50, false, version = 1)
+        val current = cycle("c", "Engineer", 90, true, version = 2)
+        assertNull(CycleScoreAggregation.previousScore(listOf(previousIncomplete, current), current))
+
+        val previousComplete = cycle("p2", "Engineer", 70, true, version = 1)
+        assertEquals(
+            70,
+            CycleScoreAggregation.previousScore(listOf(previousComplete, current), current)
+        )
+
+        val currentIncomplete = cycle("c2", "Engineer", 90, null, version = 2)
+        assertNull(
+            CycleScoreAggregation.previousScore(listOf(previousComplete, currentIncomplete), currentIncomplete)
+        )
+    }
+
+    @Test
+    fun `no complete evaluations returns unavailable aggregates`() {
+        val cycles = listOf(
+            cycle("a", "Engineer A", 80, false),
+            cycle("b", "Engineer B", 90, null)
+        )
+
+        assertNull(CycleScoreAggregation.averageScore(cycles))
+        assertNull(CycleScoreAggregation.bestScoringRole(cycles))
+        assertEquals(2, CycleScoreAggregation.incompleteScoreCount(cycles))
+    }
+
+    @Test
+    fun `invisible incomplete records are excluded from aggregates and count`() {
+        val cycles = listOf(
+            cycle("a", "Engineer A", 80, true),
+            cycle("b", "Engineer B", 100, false, visible = false)
+        )
+
+        assertEquals(80, CycleScoreAggregation.averageScore(cycles))
+        assertEquals("Engineer A", CycleScoreAggregation.bestScoringRole(cycles))
+        assertEquals(0, CycleScoreAggregation.incompleteScoreCount(cycles))
+    }
+
+    @Test
+    fun `improved count excludes incomplete later version`() {
+        val previous = cycle("p", "Engineer", 60, true, version = 1)
+        val current = cycle("c", "Engineer", 90, false, version = 2)
+
+        assertEquals(0, CycleScoreAggregation.improvedApplicationsCount(listOf(previous, current)))
+    }
+
+    @Test
+    fun `improved count excludes complete lower score`() {
+        val previous = cycle("p", "Engineer", 80, true, version = 1)
+        val current = cycle("c", "Engineer", 70, true, version = 2)
+
+        assertEquals(0, CycleScoreAggregation.improvedApplicationsCount(listOf(previous, current)))
+    }
+
+    @Test
+    fun `improved count excludes complete equal score`() {
+        val previous = cycle("p", "Engineer", 80, true, version = 1)
+        val current = cycle("c", "Engineer", 80, true, version = 2)
+
+        assertEquals(0, CycleScoreAggregation.improvedApplicationsCount(listOf(previous, current)))
+    }
+
+    @Test
+    fun `improved count includes complete strictly higher comparable score`() {
+        val previous = cycle("p", "Engineer", 60, true, version = 1)
+        val current = cycle("c", "Engineer", 90, true, version = 2)
+
+        assertEquals(1, CycleScoreAggregation.improvedApplicationsCount(listOf(previous, current)))
+    }
+
+    @Test
+    fun `improved count excludes unavailable or invalid comparison`() {
+        val noPrior = cycle("c", "Engineer", 90, true, version = 2)
+        assertEquals(0, CycleScoreAggregation.improvedApplicationsCount(listOf(noPrior)))
+
+        val incompletePrior = cycle("p", "Engineer", 60, false, version = 1)
+        val current = cycle("c2", "Engineer", 90, true, version = 2)
+        assertEquals(0, CycleScoreAggregation.improvedApplicationsCount(listOf(incompletePrior, current)))
+
+        val noVersion = cycle("n", "Engineer", 90, true, version = null)
+        assertEquals(0, CycleScoreAggregation.improvedApplicationsCount(listOf(noVersion)))
+    }
+
+    @Test
+    fun `improved count does not compare unrelated contexts`() {
+        val previous = cycle("p", "Engineer", 60, true, version = 1)
+        val differentTitle = cycle("c", "Manager", 90, true, version = 2)
+        assertEquals(0, CycleScoreAggregation.improvedApplicationsCount(listOf(previous, differentTitle)))
+
+        val differentCompany = cycle("c2", "Engineer", 90, true, version = 2).copy(company = "Other")
+        assertEquals(0, CycleScoreAggregation.improvedApplicationsCount(listOf(previous, differentCompany)))
+    }
+
+    @Test
+    fun `version number alone cannot establish improvement`() {
+        val completeV2WithoutPrior = cycle("v2", "Engineer", 90, true, version = 2)
+        assertEquals(0, CycleScoreAggregation.improvedApplicationsCount(listOf(completeV2WithoutPrior)))
+
+        val incompleteV2 = cycle("v2i", "Engineer", 70, false, version = 2)
+        val completeV3 = cycle("v3", "Engineer", 95, true, version = 3)
+        assertEquals(0, CycleScoreAggregation.improvedApplicationsCount(listOf(incompleteV2, completeV3)))
+    }
+    @Test
+    fun `authoritative aggregates ignore provisional scores`() {
+        val cycles = listOf(
+            cycle("a", "Engineer A", 80, true, provisional = 100),
+            cycle("b", "Engineer B", 60, true, provisional = 10)
+        )
+
+        assertEquals(70, CycleScoreAggregation.averageScore(cycles))
+        assertEquals("Engineer A", CycleScoreAggregation.bestScoringRole(cycles))
+    }
+
+    @Test
+    fun `incomplete record with provisional score is still excluded`() {
+        val cycles = listOf(
+            cycle("a", "Engineer A", 80, true, provisional = 80),
+            cycle("b", "Engineer B", 100, false, provisional = 100)
+        )
+
+        assertEquals(80, CycleScoreAggregation.averageScore(cycles))
+        assertEquals(1, CycleScoreAggregation.incompleteScoreCount(cycles))
+    }
+
+    @Test
+    fun `provisional values do not affect previous score or improvement`() {
+        val previous = cycle("p", "Engineer", 60, true, provisional = 100, version = 1)
+        val current = cycle("c", "Engineer", 90, true, provisional = 10, version = 2)
+
+        assertEquals(
+            60,
+            CycleScoreAggregation.previousScore(listOf(previous, current), current)
+        )
+        assertEquals(1, CycleScoreAggregation.improvedApplicationsCount(listOf(previous, current)))
+    }
+}
