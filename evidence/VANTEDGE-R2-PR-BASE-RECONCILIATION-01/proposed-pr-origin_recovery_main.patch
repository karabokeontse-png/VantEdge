+            axisScores = listOf(
+                AxisScore("SkillMatch", 0.75),
+                AxisScore("ExperienceAlignment", 0.85),
+                AxisScore("RoleRelevance", 0.90),
+                AxisScore("KeywordCoverage", 0.70),
+                AxisScore("SeniorityFit", 1.0),
