+
+    @Test
+    fun `unmapped requirement is unassessed and is not a confirmed gap`() {
+        val mapped = map(
+            profile(),
+            job(),
+            listOf(skill("Kotlin"), skill("Data Protection", canonical = null, status = ClassificationStatus.UNMAPPED))
