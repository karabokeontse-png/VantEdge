+            originalText = text,
+            category = RequirementCategory.SKILL,
+            classificationStatus = status,
+            matchedTaxonomySkill = canonical,
+            importance = "MANDATORY"
+        )
+
+    private fun degree(text: String) = RequirementEvidence(
+        originalText = text,
+        category = RequirementCategory.DEGREE,
