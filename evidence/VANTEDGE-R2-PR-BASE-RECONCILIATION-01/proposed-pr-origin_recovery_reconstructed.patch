+        breakdown = ScoreBreakdown(emptyList()),
+        gapAnalysis = gaps,
+        hints = RecommendationHints(emptyList()),
+        trace = W5TraceContext("w6", "", 0L),
+        unknownAxes = axisScores.filterNot { it.isMeasured }.map { it.axisName }
