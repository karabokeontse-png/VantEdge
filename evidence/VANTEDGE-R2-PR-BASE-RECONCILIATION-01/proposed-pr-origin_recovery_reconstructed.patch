+
+class ConfidenceEngineUnknownTest {
+
+    @Test
+    fun `missing llm confidence is not fabricated as a fallback`() {
+        val result = ConfidenceEngine.compute(
+            llmConfidenceMap = emptyMap(),
+            semanticAdjustments = mapOf("title" to 0.1f),
