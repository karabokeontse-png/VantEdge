+        assertEquals("Not a job posting", (state as JobExtractionState.Failure).message)
+    }
+}
diff --git a/app/src/test/java/com/vantedge/app/domain/extraction/ExtractionDecisionCoordinatorUnknownTest.kt b/app/src/test/java/com/vantedge/app/domain/extraction/ExtractionDecisionCoordinatorUnknownTest.kt
new file mode 100644
