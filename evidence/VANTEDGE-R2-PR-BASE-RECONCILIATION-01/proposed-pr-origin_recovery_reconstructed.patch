+
+    @Test
+    fun `priority ordering - gapClosurePlan sorted by priority ASC then estimatedImpact DESC`() {
+        val profile = ValidatedProfile(
+            correlationId = "prio",
+            skills = emptyList(),
+            roles = emptyList(),
+            currentTitle = null,
