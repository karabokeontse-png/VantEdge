diff --git a/.github/workflows/h3-corrupted-ocr-test.yml b/.github/workflows/h3-corrupted-ocr-test.yml
new file mode 100644
index 0000000..299873d
--- /dev/null
+++ b/.github/workflows/h3-corrupted-ocr-test.yml
@@ -0,0 +1,40 @@
+name: H-3 Corrupted OCR Detection Test
+
+on:
+  workflow_dispatch:
+
+jobs:
+  corrupted-ocr-test:
+    name: Corrupted OCR Confidence Test
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v4
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v4
+        with:
+          java-version: '17'
+          distribution: 'temurin'
+          cache: gradle
+
+      - name: Grant execute permission for gradlew
+        run: chmod +x gradlew
+
+      - name: Run ConfidenceEngine Corrupted OCR Test
+        run: |
+          ./gradlew testDebugUnitTest \
+            --tests "com.vantedge.app.data.engine.extraction.ConfidenceEngineCorruptedOcrTest" \
+            --no-daemon --stacktrace
+
+      - name: Upload H-3 Corrupted OCR Report
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: h3-corrupted-ocr-report
+          path: |
+            app/build/h3-corrupted-ocr-report.json
+            app/build/test-results/testDebugUnitTest/TEST-com.vantedge.app.data.engine.extraction.ConfidenceEngineCorruptedOcrTest.xml
+            app/build/reports/tests/testDebugUnitTest/
