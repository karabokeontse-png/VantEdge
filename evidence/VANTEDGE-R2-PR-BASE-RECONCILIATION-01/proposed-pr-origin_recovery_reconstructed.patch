+
+class W6UnknownAxisTest {
+
+    private fun profile() = ValidatedProfile(
+        correlationId = "w6",
+        skills = listOf("Kotlin"),
+        roles = listOf("Developer"),
+        currentTitle = "Developer",
+        experienceYears = 5,
+        seniorityLevel = "senior",
