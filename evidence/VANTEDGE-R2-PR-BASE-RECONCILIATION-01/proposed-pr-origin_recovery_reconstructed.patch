+            currentEnd = maxOf(currentEnd, end)
+        } else {
+            merged.add(currentStart to currentEnd)
+            currentStart = start
+            currentEnd = end
+        }
+    }
+    merged.add(currentStart to currentEnd)
+    return merged.sumOf { (start, end) -> end - start }
