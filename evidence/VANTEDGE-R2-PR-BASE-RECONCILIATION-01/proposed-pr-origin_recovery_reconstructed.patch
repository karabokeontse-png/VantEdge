+import com.vantedge.app.w5.scoring.ScoreResult
+import com.vantedge.app.w5.scoring.ValidatedJob
+import com.vantedge.app.w5.scoring.ValidatedProfile
+
+enum class AxisName {
+    SKILL_MATCH,
+    EXPERIENCE_ALIGNMENT,
